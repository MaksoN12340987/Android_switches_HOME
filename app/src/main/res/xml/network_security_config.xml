<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Разрешаем cleartext трафик для локальных адресов -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain> <!-- IP для эмулятора -->
        <domain includeSubdomains="true">192.168.0.149</domain> <!-- Замените на IP вашего компьютера -->
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>